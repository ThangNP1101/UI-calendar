# Public/frontend configuration only.
VITE_AUTH_ENABLED=false
VITE_API_BASE_URL=/api/v1
VITE_API_WITH_CREDENTIALS=true
VITE_SSO_CLIENT_ID=
VITE_SSO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_SSO_AUTHORIZATION_URL=
VITE_SSO_SCOPE=openid

# Expected backend contracts. These are configurable because Swagger does not
# currently expose SSO callback or session-check routes.
VITE_BACKEND_SSO_CALLBACK_ENDPOINT=/auth/sso/callback
VITE_AUTH_SESSION_ENDPOINT=
